name: the chat panel's Options tab: Interface, Graphics, Sound and Chat Font picked from its drop-down, each shown and cancelled
# ui_chat_panel.cpp's 0x569A00 opens the item's window over the panel (+0xF8): UIOptionSliderClass in mode 1, whose
# Cancel only closes it (no return to the main page, 'opt01a'); 'Chat Font' is 0x56C7E0's font window
# (ui_option_font.cpp). Control is _wip_option_control's; Credits and Self Help are web pages (UIPopupBrowserClass).
timeout: 400
include _login
expect-no proxy 'fa_opt01a\.ini'
click gadget chat.tab.options
alive 0.5
click gadget options.interface
expect-event proxy 'fa_opt04a-interface\.ini", R, disposition 3\) = ok' within 10
wait-quiet proxy 1.0 within 15
shot combo_interface
click gadget optslider.cancel
expect-event proxy 'fa_opt04a-interface\.ini", R, disposition 3\) = ok' within 10
wait-quiet proxy 1.0 within 15
click gadget chat.tab.options
alive 0.5
click gadget options.graphics
expect-event proxy 'fa_opt04a-graphics\.ini", R, disposition 3\) = ok' within 10
wait-quiet proxy 1.0 within 15
click gadget optslider.cancel
expect-event proxy 'fa_opt04a-graphics\.ini", R, disposition 3\) = ok' within 10
wait-quiet proxy 1.0 within 15
click gadget chat.tab.options
alive 0.5
click gadget options.sound
expect-event proxy 'fa_opt04a-sound\.ini", R, disposition 3\) = ok' within 10
wait-quiet proxy 1.0 within 15
click gadget optslider.cancel
expect-event proxy 'fa_opt04a-sound\.ini", R, disposition 3\) = ok' within 10
wait-quiet proxy 1.0 within 15
click gadget chat.tab.options
alive 0.5
click gadget options.chatfont
expect-event proxy 'fc_option_font\.ini", R, disposition 3\) = ok' within 10
wait-quiet proxy 1.0 within 15
click gadget optfont.cancel
expect-event proxy 'fc_option_font\.ini", R, disposition 3\) = ok' within 10
wait-quiet proxy 1.0 within 15
