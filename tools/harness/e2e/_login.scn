# Shared: the login screen, character select, the world. Included by every scenario; not run on its own. In a
# session of several scenarios it runs once, for the first (tools/harness/e2e.py).
# antprox /REPLAY serves Karen (slot 0, Jupiter). Events are antprox.out's lines (the replay server's).
messages: on
# The start-up movie (eb_sizzle.bik, MovieTaskClass, tsk_movie.cpp) is skipped with a click, as the client does:
# MovieTaskClass::Handle_Input (0x76C5A0) calls BINKMovie::Stop and removes the task once 3000 ms have passed since
# the movie's first frame. WinMain's 'Server initialized & ready to go' (messages.log) comes just before the kernel
# runs the movie; clicks before the client's own 3000 ms guard has passed are ignored, so the click repeats until the
# version check shows the movie is over.
wait-event msg 'Server initialized & ready to go' within 60
click 640,512 until antprox 'Global connection #1: sent VERSION_RESPONSE' every 0.5 within 120
# the login screen takes its first clicks once it has loaded (no log line for "drawn": its file opens end)
wait-quiet proxy 0.5 within 20
click gadget login.username
text tester
click gadget login.password
text secret
click gadget login.ok
wait-event antprox 'sent GLOBAL_AVATAR_LIST' within 30
# character select builds its avatars after the list (no log line for "ready": its file opens end)
wait-quiet proxy 1.0 within 40
click gadget select.slot0
# character select takes no input while its opening plays (nothing is logged at its end): the slot and Enter are
# posted again until the client asks for the ticket
click gadget select.enter until antprox 'received GLOBAL_TICKET_REQUEST' redo 1 every 1 within 60
wait-event antprox 'received START_ACK' within 120
# the world loads its sector and HUD (no log line for "drawn": its file opens end)
wait-quiet proxy 1.5 within 40
