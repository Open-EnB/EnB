name: a recorded session in the world: /play 1 on the Broadcast channel (ea/alex3, Heidl, 2004-04-14), then /stop
# antprox /REPLAY's chat commands (/help, /list, /play ID, /pause, /resume, /stop: Antares.Replay ReplayCommands.cs)
# are read from the Broadcast channel; Backspace opens the chat entry on Broadcast (Return opens the current channel,
# which the server does not read commands from). /play hands the client off into the recording's first sector: its
# objects, effects and packets are a real session's, far more than the empty home sector's.
# The recording's starbase (session 1) hands the client on into sector 4505 (session 2, a combat scene), which runs
# 20 s; /stop then hands it back to the home sector, whose new connection (#4) answers START_ACK, and input works
# there again. antreplay logs no START_ACK for a playback's connections: session 2 is waited on by its playback line
# (the next connection after session 1's; its number depends on what ran before in the client's session).
timeout: 400
include _login
key 0x08
expect-event proxy '^input: replayed key 0x8'
alive 1
text '/play 1'
key 0x0D
expect-event antprox 'command "/play 1"' within 10
wait-event antprox 'sent SERVER_HANDOFF' within 20
expect-event proxy 'fc_map_load00' within 10
shot handoff_loading
wait-event antprox 'Sector connection #[0-9]+: playback of 1, sector session 2 of 2' within 60
wait-quiet proxy 2 within 60
shot play1_entered
alive 20
shot play1_20s
key 0x08
alive 1
text '/stop'
key 0x0D
expect-event antprox 'command "/stop"' within 10
wait-event antprox 'playback of 1 stopped \(/stop\)' within 10
wait-event antprox 'sent SERVER_HANDOFF.*back to' within 10
wait-event antprox 'Sector connection #[0-9]+: received START_ACK' within 120
wait-quiet proxy 2 within 60
alive 8
shot play1_stopped
