name: open the navigation (star) map from its HUD button, then close it
# The window opens and closes (shots); its map gadgets are the client's (gd_starmap.cpp, gd_galaxy_map.cpp).
timeout: 400
include _login
alive 8
click gadget hud.navmap
expect-event stubs '^POC input: replayed mouse 0x202 at 140, 946'
alive 4
shot starmap_open
click gadget hud.navmap
expect-event stubs '^POC input: replayed mouse 0x202 at 140, 946'
alive 4
shot starmap_closed
alive 5
