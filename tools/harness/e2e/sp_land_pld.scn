# Space (live server): test-plan SP-12, bug B-29: the land's normal-index table (LandClass +0x1E4). sp_land's flow up to
# the surface (Elanor wormholes to Endriago, targets the planet, warps and lands; Porvenir Mons Area, 2295) and no
# further: the surface's LandClass::Load_Assets (0x4691D0) computes its horizon tables when the instance has no
# endriago_256.pld newer than the .pgm, the colour map and the ini (Compute_Horizons 0x46E670, whose normal step
# 0x46F120 fills +0x1E4 through Nearest_Normal 0x46F0A0) and writes them with Save_PLD 0x46ECF0 (+0x1E4 first). The
# .pld is the client's own dump of the table: run it through `pldcheck.py run`, which deletes the instance's .pld
# files before each run and collects the one the client writes (an instance's Data\client\output is its own copy).
# Without pldcheck.py the stored .pld is loaded and 0x46F120 never runs. No Net-7 restart is needed: the tables
# depend on the height map and the ini only (the planets' places do not enter them).
#   pldcheck.py run --instance NAME [--retail | --exe PATH] --runs N --out DIR
name: space: land on Endriago, the surface's horizon tables written (SP-12, B-29)
timeout: 360
include _login_space
key 0x0D
wait-quiet proxy 0.5 within 10
text '/wormhole 2210'
key 0x0D
wait-event antprox 'sent SERVER_HANDOFF' within 60
wait-event antprox 'received START_ACK$' within 120
wait-quiet proxy 1.5 within 60
key 0x57 until antprox 'sent SET_TARGET$' every 1.5 within 15
wait-quiet proxy 0.5 within 10
click 1248,987 until antprox 'sent SET_TARGET$' every 1.5 within 15
wait-quiet proxy 0.5 within 10
click 1248,987 until antprox 'sent SET_TARGET$' every 1.5 within 15
wait-quiet proxy 0.5 within 10
shot planet_target
key 0x51
expect-event antprox 'received WARP$' within 10
wait-event antprox 'sent WARP_INDEX$' within 120
wait-quiet proxy 1.0 within 20
click 1238,672 until antprox 'received ACTION$' every 3 within 60
wait-event antprox 'sent SERVER_HANDOFF' within 30
move 1000,880
# the surface loads (the .pgm, its ini and colour map; the .pld written) before the client's START_ACK
wait-event antprox 'received START_ACK$' within 180
wait-event antprox 'sent CAMERA_CONTROL$' within 30
wait-since antprox 'sent CAMERA_CONTROL$' 6
shot surface
expect-no CRASH
