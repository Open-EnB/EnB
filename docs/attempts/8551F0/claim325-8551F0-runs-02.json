      "patch": "--- app/wwudp/cordcon.cpp\n+++ app/wwudp/cordcon.cpp\n@@ -2087,6 +2087,13 @@\n \tQueued_++;\n }\n \n+static inline bool Cord_Pop_Pending_Ack(ArrayList<unsigned int> &acks, unsigned int &seq, int &pending) // NAME 1: coupled dequeue/count operation in buildHeader and pump\n+{\n+\tif (!acks.removeHead(seq)) return false;\n+\tpending--;\n+\treturn true;\n+}\n+\n // 0x8551F0: the datagram header and the ack list (at most 8 acks and 32 resend requests).\n bool CordCon::buildHeader(unsigned char *out, int *len, unsigned short *counter)\n {\n@@ -2099,7 +2106,7 @@\n \tint entries = 0;\n \tint last = 0;\n \tunsigned int seq = 0;\n-\t*(unsigned short *)(out + 1) = htons((unsigned short)Session_);\n+\tunsigned short session = (unsigned short)Session_; session = htons(session); *(unsigned short *)(out + 1) = session;\n \t*counter = (unsigned short)PacketsOut_;\n \t*(unsigned short *)(out + 3) = htons(*counter);\n \t*(unsigned long *)(out + 5) = htonl(0);\n@@ -2143,8 +2150,8 @@\n \t\t\tlast = entries;\n \t\t\ti = 0;\n \t\t}\n-\t\tif (acks < 8 && Active_[i]->ToAck.removeHead(seq)) {\n-\t\t\tAcksPending_--;\n+\t\tif (acks < 8 && Cord_Pop_Pending_Ack(Active_[i]->ToAck, seq, AcksPending_)) {\n+\n \t\t\tlist[pos++] = 0;\n \t\t\tpos += Cord_Put_Small(list + pos, (unsigned short)Active_[i]->Index);\n \t\t\tpos += Cord_Put_Seq(list + pos, seq);\n",
