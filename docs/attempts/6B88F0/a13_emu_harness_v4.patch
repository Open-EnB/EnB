+"""A13: generic pair runner and positive controls on top of emu.py (A12's interpreter, extended in .work/a13).
+
+    H = Harness(obj, symbol, client_addr, nargs, void)
+    H.run(cases, setup(case) -> setup_fn, stubs(case) -> stubs_fn, seeds)
+    H.controls(cases, ...)  # mutate ours, expect a DIFF
+"""
+import struct
+import sys
+sys.path.insert(0, 'C:/EnBDevelopment/EnB/.work/a13')
+import emu  # noqa: E402
+import os  # noqa: E402
+emu.PC24 = os.environ.get('PC24') == '1'
+print('x87 precision:', '24 bits (D3D8 game mode)' if emu.PC24 else '53 bits (CRT default)')
+from capstone import x86  # noqa: E402
+
+
+def fhash(seed, *k):
+    """A float in [-4, 4) from integers: identical on both sides for the same key."""
+    h = 2166136261
+    for v in (seed,) + k:
+        h = ((h ^ (v & 0xFFFFFFFF)) * 16777619) & 0xFFFFFFFF
+    return ((h >> 8) % 8000) / 1000.0 - 4.0
+
+
+def f32(v):
+    return struct.unpack('<f', struct.pack('<f', v))[0]
+
+
+class Harness:
+    def __init__(self, obj, symbol, client_addr, nargs, void=True, ignore_st=False, retmask=0xFFFFFFFF, stk_any=False, fret=False):
+        self.entry, self.reader, self.extra, self.names = emu.link_ours(obj, symbol)
+        self.creader = emu.client_reader()
+        self.both = lambda eip: self.reader(eip) if eip >= emu.OURS_CODE else self.creader(eip)
+        self.caddr = client_addr
+        self.nargs = nargs
+        self.void = void
+        self.ignore_st = ignore_st
+        self.retmask = retmask
+        self.stk_any = stk_any
+        self.fret = fret
+
+    def one(self, case, seed, setup, stubs):
+        a = emu.run_one(self.entry, self.both, self.extra, seed, setup(case), stubs(case), self.nargs)
+        b = emu.run_one(self.caddr, self.creader, {}, seed, setup(case), stubs(case), self.nargs)
+        if self.stk_any:  # frames differ: a pointer into the frame is compared as 'stk' (contents via the stubs)
+            for r in (a, b):
+                for c in r['calls']:
+                    c['args'] = ['stk' if isinstance(x, tuple) else x for x in c['args']]
+        if self.ignore_st:
+            for r in (a, b):
+                for c in r['calls']:
+                    c.pop('st', None)
+        a['eax'] &= self.retmask
+        b['eax'] &= self.retmask
+        d = emu.compare(a, b)
+        if self.fret and a['stvals'] != b['stvals']:  # a float returned in st0
+            d.append('st0: ours %r client %r' % (a['stvals'], b['stvals']))
+        if self.void:
+            d = [x for x in d if not x.startswith('eax:')]
+        return a, b, d
+
+    def run(self, cases, setup, stubs, seeds=(1, 2), verbose=True, label=''):
+        emu.COV = set()
+        bad = 0
+        n = 0
+        stat = {}
+        for case in cases:
+            for seed in seeds:
+                a, b, d = self.one(case, seed, setup, stubs)
+                n += 1
+                if verbose:
+                    print('%s case %r seed %d: client %s, %d calls, %d bytes written, %d steps: %s' % (
+                        label, case, seed, b['status'], len(b['calls']), len(b['writes']), b['steps'],
+                        'SAME' if not d else 'DIFF'))
+                    for x in d[:4]:
+                        print('    ' + x[:600])
+                bad += bool(d)
+                k = b['status'] if not b['status'].startswith('stop') else b['status'][:60]
+                stat[k] = stat.get(k, 0) + 1
+        print('%s differing runs: %d of %d; client statuses %r' % (label, bad, n, stat))
+        return bad
+
+    def coverage(self, size=None):
+        """Share of the client function's reachable instructions (traversed from its start) the runs executed."""
+        seen = set()
+        todo = [self.caddr]
+        while todo:
+            va = todo.pop()
+            while va not in seen:
+                ins = self.creader(va)
+                seen.add(va)
+                mn = ins.mnemonic
+                if mn.startswith('j') and ins.operands[0].type == x86.X86_OP_IMM:
+                    todo.append(ins.operands[0].imm & 0xFFFFFFFF)
+                    if mn == 'jmp':
+                        break
+                elif mn == 'jmp' and ins.operands[0].type == x86.X86_OP_MEM and ins.operands[0].mem.disp:
+                    tab = ins.operands[0].mem.disp & 0xFFFFFFFF  # a switch table: follow its entries
+                    for k in range(64):
+                        t = int.from_bytes(emu.IMG.data[emu.IMG.offset(tab + 4 * k):emu.IMG.offset(tab + 4 * k) + 4],
+                                           'little')
+                        if not self.caddr <= t < self.caddr + 0x4000:
+                            break
+                        todo.append(t)
+                    break
+                elif mn in ('ret', 'jmp', 'int3'):
+                    break
+                va += ins.size
+        hit = sorted(a for a in seen if a in emu.COV)
+        miss = sorted(a for a in seen if a not in emu.COV)
+        print('client coverage: %d of %d reachable instructions; missed %s' % (len(hit), len(seen),
+              [hex(a) for a in miss[:16]]))
+
+    # ---- positive controls
+    def find(self, pred, nth=0):
+        code = bytes(self.reader.code)
+        k = 0
+        for ins in emu.MD.disasm(code, emu.OURS_CODE):
+            if ins.address < self.entry:
+                continue
+            if pred(ins):
+                if k == nth:
+                    return ins.address - emu.OURS_CODE, ins
+                k += 1
+        raise SystemExit('control site not found')
+
+    def mutate(self, label, off, k, val, cases, setup, stubs, seeds=(1,)):
+        code = self.reader.code
+        saved = code[off + k]
+        code[off + k] = val
+        self.reader.cache.clear()
+        bad = 0
+        n = 0
+        for case in cases:
+            for seed in seeds:
+                _, _, d = self.one(case, seed, setup, stubs)
+                bad += bool(d)
+                n += 1
+        code[off + k] = saved
+        self.reader.cache.clear()
+        print('control %s: %d of %d runs differ (%s)' % (label, bad, n, 'CAUGHT' if bad else 'MISSED'))
+        return bad
+
+
+def summary(H, cases, setup, stubs, seeds):
+    """Count the differing runs by (kinds, dword addresses written differently)."""
+    from collections import Counter
+    c = Counter()
+    for case in cases:
+        for seed in seeds:
+            a, b, d = H.one(case, seed, setup, stubs)
+            if d:
+                offs = sorted({x & ~3 for x in a['writes'] if a['writes'][x] != b['writes'].get(x)})
+                c[(tuple(hex(o) for o in offs[:6]), tuple(x.split(':')[0].split(' ')[0] for x in d))] += 1
+    for k, v in c.most_common(12):
+        print(v, k)
