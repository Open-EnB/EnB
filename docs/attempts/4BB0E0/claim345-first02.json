          "text": "static char SectionBuffer[0x200];  // NAME 2: holds the converted section"
        },
        {
          "start": 681,
          "end": 681,
          "text": "inline static const char *Make_Section(const char *base, const char *append, char *section)  // NAME 2: describes what it does\n{"
        },
        {
          "start": 683,
          "end": 683,
          "text": "\tG_ASSERT(base);"
        },
        {
          "start": 684,
          "end": 684,
          "text": "\tG_ASSERT(append);"
        },
        {
          "start": 685,
          "end": 685,
          "text": "\tG_ASSERT(section);"
        },
        {
          "start": 686,
          "end": 686,
          "text": "\tstrcpy(section, base);"
        },
        {
          "start": 687,
          "end": 687,
          "text": "\tstrcpy(SectionBuffer, append);"
        },
        {
          "start": 688,
          "end": 688,
          "text": "\tReplace_Char(SectionBuffer, '.', '\\\\');"
        },
        {
          "start": 689,
          "end": 689,
          "text": "\tchar *entry = strrchr(SectionBuffer, '\\\\');"
        },
        {
          "start": 690,
          "end": 690,
          "text": "\tif (entry != NULL) {"
        },
        {
          "start": 691,
          "end": 691,
          "text": "\t\t*entry = '\\0'; entry++;"
        },
        {
          "start": 692,
          "end": 692,
          "text": "\t\tstrcat(section, \"\\\\\");"
        },
        {
          "start": 693,
          "end": 693,
          "text": "\t\tstrcat(section, SectionBuffer);"
        },
        {
          "start": 694,
          "end": 694,
          "text": "\t} else {"
        },
        {
          "start": 695,
          "end": 695,
          "text": "\t\tentry = SectionBuffer;"
        },
        {
          "start": 696,
          "end": 696,
          "text": "\t}"
        },
        {
          "start": 697,
          "end": 697,
          "text": "\treturn entry;"
        },
        {
          "start": 698,
          "end": 698,
          "text": "}"
        },
        {
          "start": 2174,
          "end": 2174,
          "text": "// NOT EXACT: candidate reconstructed from retail instructions\nbool Unknown_4BB0E0(KVListClass &list, INIClass &ini, const char *base)  // NAME 1: neutral address\n{\n\tunsigned int count = list.Get_Count();\n\tfor (unsigned int i = 0; i < count; i++) {\n\t\tKVPairClass *pair = list.Get(i);"
        },
        {
          "start": 2178,
          "end": 2178,
          "text": "\t\tG_ASSERT(pair);"
        },
        {
          "start": 2179,
          "end": 2179,
          "text": "\t\tchar section[0x200];"
        },
        {
          "start": 2180,
          "end": 2180,
          "text": "\t\tconst char *entry = Make_Section(base, pair->Key.Get_String(), section);"
        },
        {
          "start": 2181,
          "end": 2181,
          "text": "\t\tchar value[0x300];"
        },
        {
          "start": 2182,
          "end": 2182,
          "text": "\t\tsprintf(value, \"{%s}:{%s}\", pair->Get_Type_Name(), pair->Get_Value_String());"
        },
        {
          "start": 2183,
          "end": 2183,
          "text": "\t\tif (!ini.Put_String(section, entry, value)) return false;"
        },
        {
          "start": 2184,
          "end": 2184,
          "text": "\t}"
        },
        {
          "start": 2185,
          "end": 2185,
          "text": "\treturn true;"
        },
        {
          "start": 2186,
          "end": 2191,
          "text": "}"
        }
      ]
