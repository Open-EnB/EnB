+
+    def f(mem, cpu, seed):
+        mem.wu(THIS + 0x90, 4, HF)
+        mem.wu(THIS + 0x1E4, 4, OUT)
+        mem.write(HF + 0xC, struct.pack('<f', sp))
+        mem.wu(HF + 0x20, 4, n)
